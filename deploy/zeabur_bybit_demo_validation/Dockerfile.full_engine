# Full Engine Validation image — GitHub-native (repository-root build context)
#
# Build (from repository root on main):
#   docker build \
#     -f deploy/zeabur_bybit_demo_validation/Dockerfile.full_engine \
#     --build-arg GITHUB_SHA="$(git rev-parse HEAD)" \
#     -t nexus-demo-val-full .
#
# Zeabur service must pin:
#   ZBPACK_DOCKERFILE_PATH=deploy/zeabur_bybit_demo_validation/Dockerfile.full_engine
#
# Do NOT assemble /tmp/*_ctx trees. Do NOT ZIP as primary source.

FROM python:3.11-slim-bookworm

# Local/CI may pass GITHUB_SHA. Zeabur Git services expose ZEABUR_GIT_COMMIT_SHA
# during the build phase; use it as the canonical fallback for UI-triggered redeploys.
ARG GITHUB_SHA=
ARG ZEABUR_GIT_COMMIT_SHA=

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    BYBIT_DEMO=true \
    MAINNET=false \
    REAL_MONEY=false \
    DEMO_AUTONOMOUS_ENABLED=false \
    AUTONOMOUS_SEND=false \
    EXCHANGE_WRITE=false \
    NEXUS_WEB_ONLY=true \
    NEXUS_EMBEDDED_WORKER=false \
    FIXED_LEVERAGE=25 \
    NEXUS_DATA_ROOT=/app/data/nexus_demo_validation \
    NEXUS_DATA_DIR=/app/data/nexus_demo_validation \
    NEXUS_VALIDATION_BOOT=full_engine \
    PORT=8080

WORKDIR /app

RUN mkdir -p /app/data/nexus_demo_validation /data/nexus_demo_validation || true

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Application source from repository root (GitHub main = source-of-truth).
COPY app.py run.py gunicorn.conf.py zbpack.json ./
COPY backend/ backend/
COPY config/ config/
COPY static/ static/
COPY templates/ templates/
# Full runtime needs more than CI helpers; e.g. customer-validation concierge imports
# tools.customer_validation at app import time. Keep the repository tools tree available
# (subject to .dockerignore exclusions such as bulk research tools).
COPY tools/ tools/

# Packaging layer — never assume these files live at repo root.
COPY deploy/zeabur_bybit_demo_validation/entrypoint.sh ./entrypoint.sh
COPY deploy/zeabur_bybit_demo_validation/demo_founder_gate.env ./demo_founder_gate.env
COPY deploy/zeabur_bybit_demo_validation/validation_health_server.py ./validation_health_server.py

# Bake deployment identity. Prefer explicit CI/local GITHUB_SHA; otherwise use the
# Git commit SHA provided by Zeabur during a Git-service build.
RUN chmod +x entrypoint.sh \
 && BUILD_SHA="$GITHUB_SHA" \
 && if [ -z "$BUILD_SHA" ]; then BUILD_SHA="$ZEABUR_GIT_COMMIT_SHA"; fi \
 && if [ -n "$BUILD_SHA" ]; then \
      printf '%s' "$BUILD_SHA" > DEPLOYMENT_COMMIT \
      && printf '%s' "$BUILD_SHA" > SOURCE_COMMIT; \
    else \
      : > DEPLOYMENT_COMMIT \
      && : > SOURCE_COMMIT; \
    fi \
 && test -f app.py \
 && test -f run.py \
 && test -f gunicorn.conf.py \
 && test -f entrypoint.sh \
 && test -f demo_founder_gate.env \
 && test -f validation_health_server.py \
 && test -f tools/customer_validation/__init__.py \
 && test -f backend/nexus_demo_execution/bounded_12h_session.py \
 && test -f backend/nexus_bounded_runtime/certified_session.py \
 && grep -q "BoundedAutonomousSessionEngine" backend/nexus_demo_execution/bounded_12h_session.py \
 && ! grep -q "_run_placeholder" backend/nexus_demo_execution/bounded_12h_session.py \
 && grep -q "BOUNDED_AUTONOMOUS_ENGINE_V1" backend/nexus_demo_execution/api_routes.py \
 && grep -q "FOUNDER_GATE=DEMO_AUTONOMOUS_6H_V2_BOUNDED_VALIDATION" demo_founder_gate.env \
 && grep -q "FOUNDER_6H_APPROVED=false" demo_founder_gate.env \
 && grep -q "FOUNDER_APPROVE_DEMO_AUTONOMOUS_6H_V2=false" demo_founder_gate.env

EXPOSE 8080

CMD ["/bin/sh", "./entrypoint.sh"]
