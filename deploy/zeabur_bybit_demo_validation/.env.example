# Bybit Demo Learning Validation — environment template
# Copy names into Zeabur / GitHub Secrets. NEVER put real values in git.

BYBIT_DEMO=true
MAINNET=false
REAL_MONEY=false
DEMO_AUTONOMOUS_ENABLED=false
AUTONOMOUS_SEND=false
EXCHANGE_WRITE=false
NEXUS_WEB_ONLY=true
NEXUS_EMBEDDED_WORKER=false
FIXED_LEVERAGE=25
NEXUS_DATA_ROOT=/app/data/nexus_demo_validation
NEXUS_DATA_DIR=/app/data/nexus_demo_validation
FOUNDER_GATE=DEMO_AUTONOMOUS_6H_V2_BOUNDED_VALIDATION
FOUNDER_6H_APPROVED=true

# --- secrets (set in Zeabur / GitHub only) ---
# BYBIT_DEMO_API_KEY=
# BYBIT_DEMO_API_SECRET=
# NEXUS_BOUNDED_SESSION_CONTROL_SECRET=
# NEXUS_POSTGRES_URL=
# ZEABUR_TOKEN=
