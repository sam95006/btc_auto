# NEXUS Public mobile — PROD shape only. No secrets. NON_SUBMISSION.
# Do not point mobile CI at production customer databases from this lane.
NEXUS_PUBLIC_API_BASE_PROD=https://public-api.nexus.example
NEXUS_PUBLIC_AUTH_ISSUER_PROD=https://auth.nexus.example/
NEXUS_PUBLIC_ENV=prod
NEXUS_PUBLIC_REVIEW_DEMO=0
NEXUS_PUBLIC_SUBMISSION_AUTHORIZED=0
NEXUS_PUBLIC_LIVE_BILLING=0
NEXUS_PUBLIC_REAL_IAP=0
NEXUS_PUBLIC_PRODUCTION_CUSTOMER_DB=0
