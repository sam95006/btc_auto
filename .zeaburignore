# Zeabur upload exclusions for NEXUS stage3-demo-learning (repo-root service).
# IMPORTANT: Do NOT exclude static/, backend/, app.py — Console assets and runtime
# are required by the root Dockerfile:
#   RUN test -f static/nexus/assets/nexus_overview.png \
#    && test -f static/nexus/assets/hq_roundtable.png
#
# Stage-2 shadow runner must deploy from deploy/zeabur_stage2_shadow/ with its own
# package ignore — never reuse a shadow-only ignore at repo root.

# --- Secrets (never upload) ---
.env
.env.*
*.secret
*.pem
**/credentials.json
**/*_credentials.json

# --- Local evidence / docs / tools (not required at runtime) ---
docs/
docs/evidence/
docs/promotion/
docs/archive/
archives/
scratch/
tools/research/
# V30.1 autonomy worker needs these runners inside the image (Dockerfile.autonomy).
!tools/research/activity_metric_v2/
!tools/research/activity_metric_v2/**
tests/
.pytest_cache/
.cache/

# --- Local runtime / volume data ---
data/
logs/
exports/
*.log
*.zip
*.db
*.db-*
trading.db*

# --- Dev environments ---
venv/
.venv/
node_modules/
.git/
.cursor/
.vscode/
__pycache__/
**/__pycache__/
*.py[cod]

# --- Unused repo-root artwork only (keep static/nexus/assets) ---
/assets/
