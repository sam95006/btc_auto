{
  "name": "nexus-eati-ui-mvp0",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check_member_product_generation.mjs && node scripts/check_v18_2_15_exchange_visual_terminal.mjs && node scripts/check_v18_2_16_server_side_live_radar.mjs && node scripts/check_v18_2_18_paid_product_visual.mjs && tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "check:product-gen": "node scripts/check_member_product_generation.mjs",
    "check:v18-2-15": "node scripts/check_v18_2_15_exchange_visual_terminal.mjs",
    "check:v18-2-16": "node scripts/check_v18_2_16_server_side_live_radar.mjs",
    "check:v18-2-18": "node scripts/check_v18_2_18_paid_product_visual.mjs",
    "preview": "vite preview",
    "check:safety": "node scripts/check_ui_safety.mjs",
    "check:member-bans": "node scripts/check_member_hard_bans.mjs 1 && node scripts/check_member_hard_bans.mjs 2",
    "check:member-ux": "node scripts/check_member_ux_completion.mjs 1 && node scripts/check_member_ux_completion.mjs 2 && node scripts/check_member_ux_completion.mjs 3",
    "check:a11y-i18n-perf": "node scripts/check_a11y_i18n_perf.mjs 1 && node scripts/check_a11y_i18n_perf.mjs 2 && node scripts/check_a11y_i18n_perf.mjs 3",
    "measure:perf": "node scripts/measure_performance_budget.mjs",
    "e2e": "playwright test",
    "e2e:a11y": "playwright test --grep @a11y",
    "e2e:a11y-member": "playwright test e2e/a11y-member.spec.ts",
    "e2e:visual": "playwright test --grep @visual"
  },
  "dependencies": {
    "lightweight-charts": "file:lightweight-charts-5.2.0.tgz",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
