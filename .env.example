# === Core runtime ===
NEXUS_TRADING_MODE=binance_testnet
NEXUS_EXECUTION_MODE=binance_mixed_testnet
NEXUS_RUNTIME_TICK_SECONDS=2
# 24/7: worker keeps running; major news = alert only (no 15min auto-pause)
NEXUS_ALWAYS_ON_TRADING=1
NEXUS_AI_LED_TRADING=1
NEXUS_AI_LED_PRIMARY=1
NEXUS_AI_LED_CORE_FLEETS=1
NEXUS_LLM_REFRESH_TRADE_PROPOSER_SECONDS=20
# === Live sync (Binance + global news + UI push) ===
NEXUS_EMBEDDED_WORKER=1
NEXUS_EXCHANGE_REFRESH_MIN_SECONDS=2
NEXUS_NEWS_REFRESH_SECONDS=60
NEXUS_WS_PUSH_INTERVAL_SECONDS=1
NEXUS_GLOBAL_INDEX_REFRESH_SECONDS=30
NEXUS_LIVE_REFRESH_RADAR=1
NEXUS_MEETING_TIMEZONE=Asia/Taipei
NEXUS_RUNTIME_DB=trading.db
NEXUS_BOOTSTRAP_TRADES=1

# === Binance testnet credentials (required for binance_testnet) ===
BINANCE_SPOT_TESTNET_API_KEY=
BINANCE_SPOT_TESTNET_SECRET_KEY=
BINANCE_FUTURES_TESTNET_API_KEY=
BINANCE_FUTURES_TESTNET_SECRET_KEY=
# U本位 demo 合約（勿改成幣本位 dapi 網址）
# BINANCE_FUTURES_BASE_URL=https://demo-fapi.binance.com
# NEXUS_FUTURES_SCOPE=usdt_m
# NEXUS_INCLUDE_COIN_MARGINED=0
# 儀表板資金只計 USDT（不含 USDC/BTC；對齊 Demo 資產列表 USDT 列）
NEXUS_TREASURY_ASSETS=USDT
NEXUS_HQ_SPOT_TRUTH_STABLE_ASSETS=USDT

# Optional NEXUS_* credential bridge (Phase 0.2)
# NEXUS_READ_BINANCE_API_KEY=
# NEXUS_READ_BINANCE_SECRET_KEY=
# NEXUS_TRADE_BINANCE_API_KEY=
# NEXUS_TRADE_BINANCE_SECRET_KEY=

BINANCE_TESTNET_VALIDATE_ON_BOOT=0
BINANCE_TESTNET_RECV_WINDOW=5000

# Fleet market routing
NEXUS_MARKET_TYPE_BTC=futures
NEXUS_MARKET_TYPE_ETH=futures
NEXUS_MARKET_TYPE_SOL=futures
NEXUS_MARKET_TYPE_PEPE=futures

# Optional symbol overrides
# BINANCE_FUTURES_TESTNET_SYMBOL_PEPE=1000PEPEUSDT

# === Capital / growth mode ===
NEXUS_FUTURES_BASELINE_CAPITAL=5000
NEXUS_SPOT_BASELINE_CAPITAL=5000
NEXUS_USE_LIVE_WALLET_FOR_SIZING=1
NEXUS_CAPITAL_FLOOR=4500
NEXUS_GROWTH_TARGET=7500
NEXUS_BOLD_TESTNET_CAPITAL_FLOOR=4500
NEXUS_FUTURES_DEPLOY_FRACTION=0.92
NEXUS_BOLD_TESTNET=1
NEXUS_TESTNET_SANDBOX=1
NEXUS_SANDBOX_MIN_CONFIDENCE=0.38
NEXUS_SANDBOX_MIN_APPROVAL_SCORE=0.38
NEXUS_SANDBOX_AUTO_RESET=1
NEXUS_SANDBOX_FORCE_LIVE=1

# 防手續費空轉（testnet 建議開啟）
NEXUS_FEE_CHURN_GUARD=1
NEXUS_MIN_MARGIN_USD=45
NEXUS_MIN_NOTIONAL_USD=280
NEXUS_MIN_HOLD_SECONDS=180
NEXUS_SYMBOL_REOPEN_COOLDOWN_SEC=300
NEXUS_RULE_SIGNAL_INTERVAL_SEC=120
NEXUS_AI_PROPOSAL_MAX_PER_TICK=2
NEXUS_BOLD_MIN_QUALITY=0.55
NEXUS_LLM_ENABLE=1
# Holistic LLM entry/exit (wallet + regime + external intel + radar)
NEXUS_AI_FLEX_EVAL=1
NEXUS_AI_FLEX_EXIT=1
NEXUS_AI_FLEX_PRIMARY=1
NEXUS_AI_FLEX_EXIT_PRIMARY=1
NEXUS_AI_FLEX_SIZING=1
NEXUS_AI_FLEX_AUTO_PROFIT=1
NEXUS_AI_FLEX_HEURISTIC_FALLBACK=1
NEXUS_AI_FLEX_AUTO_PROFIT_PCT=12
NEXUS_AI_FLEX_STALE_EXIT_HOURS=3
NEXUS_AI_FLEX_STALE_MIN_PROFIT_USD=4
NEXUS_AI_FLEX_STALE_FLAT_EXIT_HOURS=6
NEXUS_AI_FLEX_MIN_CONFIDENCE=0.45
NEXUS_AI_FLEX_EXIT_MIN_CONFIDENCE=0.58
NEXUS_AI_FLEX_MAX_PROPOSALS=3
NEXUS_AI_FLEX_MAX_LEVERAGE=100
NEXUS_LLM_REFRESH_FLEX_TRADE_SECONDS=18
NEXUS_LLM_REFRESH_FLEX_EXIT_SECONDS=15
NEXUS_LLM_MODEL_FLEX_TRADE=llama-3.3-70b-versatile
NEXUS_LLM_MODEL_FLEX_EXIT=llama-3.3-70b-versatile
NEXUS_PRICE_SOURCE=futures
NEXUS_AUTONOMY_LEVEL=2
NEXUS_SHADOW_MODE=0
NEXUS_LEARNING_AUTO_APPLY=1
NEXUS_LEARNING_AUTO_APPROVE=1
# Learning on testnet: shrink size/leverage instead of hard-pausing all entries
NEXUS_LEARNING_HARD_PAUSE=0
NEXUS_LEARNING_SYMBOL_COOLDOWN_SECONDS=3600
NEXUS_DAILY_PNL_TARGET_PCT=0.003
NEXUS_DAILY_MAX_LOSS_PCT=0.015

# === P3 strategy modules (grid / funding arb / DCA / monthly drawdown) ===
NEXUS_GRID_TRADING=1
NEXUS_FUNDING_ARB=1
NEXUS_DCA_ACCUMULATOR=1
NEXUS_MONTHLY_MAX_DRAWDOWN_PCT=0.10
NEXUS_MONTHLY_DRAWDOWN_GUARD=1
NEXUS_VOLATILITY_SIZING=1
NEXUS_GRID_INTERVAL_SEC=40
NEXUS_FUNDING_ARB_INTERVAL_SEC=50
NEXUS_DCA_INTERVAL_SEC=3600
NEXUS_DCA_SYMBOLS=BTCUSDT,ETHUSDT

# === R-exit (Phase 4A) ===
NEXUS_RISK_PCT=0.10
NEXUS_STOP_R=1.0
NEXUS_BREAK_EVEN_AFTER_TP1=1
NEXUS_SIGNAL_REVERSE_MIN_CONFIDENCE=0.55

# === RADAR dispatch (Phase 4C) ===
NEXUS_RADAR_AUTO_TRADE=1
NEXUS_RADAR_MIN_CANDIDATE_SCORE=55
NEXUS_RADAR_MAX_OPEN_POSITIONS=3
NEXUS_RADAR_MAX_LEVERAGE=15

# === Meetings (wall-clock for 00:00 / 06:00 / 12:00 / 18:00 roundtables) ===
NEXUS_MEETING_TIMEZONE=Asia/Taipei

# === LLM advisory ===
NEXUS_LLM_ENABLE=1
NEXUS_LLM_PROVIDER_CHAT=groq_primary
NEXUS_LLM_MODEL_CHAT=llama-3.3-70b-versatile
GROQ_API_KEY_PRIMARY=
GROQ_API_KEY_SECONDARY=
SAMBANOVA_API_KEY=
CEREBRAS_API_KEY=
# Cerebras（OpenAI 相容）：https://api.cerebras.ai/v1 — 建議 agent / regime / post_mortem
NEXUS_LLM_PROVIDER_AGENT=cerebras
NEXUS_LLM_MODEL_AGENT=llama-3.3-70b
NEXUS_LLM_PROVIDER_NEWS=groq_primary
NEXUS_LLM_PROVIDER_RADAR=groq_primary
NEXUS_LLM_PROVIDER_ROUNDTABLE=groq_secondary
NEXUS_LLM_PROVIDER_REFLECTION=groq_secondary
# 若仍用 SambaNova：NEXUS_LLM_PROVIDER_AGENT=sambanova

# === HQ spot treasury display (match Binance App: USDT + USDC only) ===
NEXUS_HQ_SPOT_TRUTH_MODE=stable_only
NEXUS_HQ_SPOT_TRUTH_STABLE_ASSETS=USDT,USDC

# === HQ spot strategy ===
NEXUS_HQ_SPOT_THRESHOLD=0.0035
NEXUS_HQ_SPOT_COOLDOWN_SECONDS=600
NEXUS_NEWS_PAUSE_SECONDS=900

# === External market intel (CoinGecko / CoinMarketCap / CryptoQuant) ===
NEXUS_EXTERNAL_MARKET_ENABLED=1
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
CRYPTOQUANT_API_KEY=
# Optional aliases: CMC_API_KEY, CRYPTOQUANT_ACCESS_TOKEN
NEXUS_COINGECKO_TOP_N=50
NEXUS_COINGECKO_MIN_VOLUME_USD=5000000
NEXUS_COINGECKO_REFRESH_SECONDS=3600
NEXUS_CMC_REFRESH_SECONDS=900
NEXUS_CMC_BTC_DOMINANCE_ALT_REDUCE=52
NEXUS_CRYPTOQUANT_REFRESH_SECONDS=3600
NEXUS_CRYPTOQUANT_INFLOW_SPIKE_BTC=8000
NEXUS_CRYPTOQUANT_OUTFLOW_SPIKE_BTC=8000
NEXUS_CRYPTOQUANT_NETFLOW_BEARISH_BTC=5000

# Fear & Greed (Alternative.me — no API key)
NEXUS_FEAR_GREED_ENABLED=1
NEXUS_FEAR_GREED_REFRESH_SECONDS=3600
NEXUS_FEAR_GREED_EXTREME_FEAR=25
NEXUS_FEAR_GREED_EXTREME_GREED=75

# Binance public macro (long/short, taker, liquidations, spot-futures premium)
NEXUS_BINANCE_MACRO_ENABLED=1
NEXUS_BINANCE_MACRO_REFRESH_SECONDS=300
NEXUS_BINANCE_MACRO_SYMBOL=BTCUSDT
NEXUS_BINANCE_MACRO_LIQ_STRESS_COUNT=12
# Optional hard blocks (default off — advisory via confidence/regime)
# NEXUS_BLOCK_EXTREME_GREED_LONGS=0
# NEXUS_BLOCK_EXTREME_FEAR_SHORTS=0

# === Confidence leverage + margin (3–100x / scaled margin by matrix score) ===
NEXUS_USE_CONFIDENCE_LEVERAGE_TABLE=1
NEXUS_USE_CONFIDENCE_MARGIN_TABLE=1
NEXUS_MAX_SYSTEM_LEVERAGE=100
NEXUS_MAX_SYSTEM_MARGIN_USD=150
NEXUS_HARD_MAX_LEVERAGE=100
NEXUS_HARD_MAX_MARGIN_USD=500
NEXUS_ABSOLUTE_MAX_LEVERAGE=100
NEXUS_ABSOLUTE_MAX_MARGIN_PCT=0.20
NEXUS_GROWTH_MAX_LEVERAGE=100
NEXUS_CONFIDENCE_BASE_MARGIN_CORE=50
NEXUS_CONFIDENCE_BASE_MARGIN_RADAR=40
NEXUS_FLEET_MARGIN_CAP_BTC=150
NEXUS_FLEET_MARGIN_CAP_ETH=120
NEXUS_FLEET_MARGIN_CAP_SOL=100
NEXUS_FLEET_MARGIN_CAP_PEPE=60
NEXUS_SANDBOX_MIN_HOLD_SECONDS=45
NEXUS_SIMULATION_SIZING=1
NEXUS_SIMULATION_EVAL_EQUITY=5000
NEXUS_SANDBOX_ABS_EXIT=1
NEXUS_SANDBOX_TP_ABS_USD=25
NEXUS_SANDBOX_SL_ABS_USD=15
NEXUS_SANDBOX_RELAX_EXIT_GUARDS=1
NEXUS_MARGIN_AGGRESSION_MULT=3.0
NEXUS_CONFIDENCE_TIER_HIGH_LEVERAGE=8

# === Zeabur / cloud (match local .env for seamless handoff) ===
# PORT is injected automatically by Zeabur for the web service.
# Mount a persistent volume at /data on BOTH web and worker services.
NEXUS_DATA_DIR=/data
NEXUS_RUNTIME_DB=trading.db
# NEXUS_EMBEDDED_WORKER=1   # force in-process worker (needed if gunicorn -w>1 or non-Zeabur host)
# NEXUS_WEB_ONLY=1          # web only: disable embedded worker when you run backend.worker.runner separately

# === Research gate + execution enhancements (Binance testnet only) ===
NEXUS_KLINE_BACKTEST_ENABLED=1
NEXUS_KLINE_BACKTEST_INTERVAL=15m
NEXUS_KLINE_BACKTEST_LOOKBACK=120
NEXUS_KLINE_BACKTEST_MIN_EDGE=0.52
NEXUS_RESEARCH_GATE_ENABLED=1
NEXUS_LEARNING_REQUIRE_RESEARCH_PASS=1
NEXUS_RESEARCH_GATE_BLOCK_ENTRIES=0
NEXUS_WALK_FORWARD_MIN_POSITIVE_RATIO=0.40
NEXUS_WALK_FORWARD_MIN_LATEST_WIN_RATE=0.38
NEXUS_TCA_ENABLED=1
NEXUS_USE_LIMIT_ORDERS=0
NEXUS_LIMIT_ORDER_OFFSET_BPS=8
NEXUS_LIMIT_FALLBACK_MARKET=1
NEXUS_TRAILING_EXIT_ADVISORY=1
NEXUS_TRADINGVIEW_WEBHOOK_ENABLED=1
NEXUS_TRADINGVIEW_WEBHOOK_SECRET=

# === Phase 8 upgrade track (P0-P3) ===
NEXUS_AUTONOMY_LEVEL=2
NEXUS_LEARNING_AUTO_APPLY=1
NEXUS_LEARNING_AUTO_APPROVE=1
NEXUS_SHADOW_MODE=0
NEXUS_AI_PROPOSAL_MAX_PER_TICK=3
NEXUS_RADAR_UNIVERSE_MAX=50
NEXUS_STRATEGY_VERSION=v1.0.0-core
NEXUS_RADAR_LLM_PROPOSALS=1
NEXUS_RADAR_LLM_MIN_CONFIDENCE=0.55
NEXUS_LLM_PROVIDER_RADAR_PROPOSAL=groq_primary
NEXUS_LLM_MODEL_RADAR_PROPOSAL=llama-3.3-70b-versatile
NEXUS_DAILY_REPORT_ENABLE=1
NEXUS_DAILY_REPORT_SLOTS=00:00,12:00
NEXUS_EMBEDDED_WORKER=1
