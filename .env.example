# === Core runtime ===
NEXUS_TRADING_MODE=binance_testnet
NEXUS_EXECUTION_MODE=binance_mixed_testnet
NEXUS_RUNTIME_TICK_SECONDS=2
NEXUS_RUNTIME_DB=trading.db
NEXUS_BOOTSTRAP_TRADES=1

# === Binance testnet credentials (required for binance_testnet) ===
BINANCE_SPOT_TESTNET_API_KEY=
BINANCE_SPOT_TESTNET_SECRET_KEY=
BINANCE_FUTURES_TESTNET_API_KEY=
BINANCE_FUTURES_TESTNET_SECRET_KEY=

# Optional NEXUS_* credential bridge (Phase 0.2)
# NEXUS_READ_BINANCE_API_KEY=
# NEXUS_READ_BINANCE_SECRET_KEY=
# NEXUS_TRADE_BINANCE_API_KEY=
# NEXUS_TRADE_BINANCE_SECRET_KEY=

BINANCE_TESTNET_VALIDATE_ON_BOOT=0
BINANCE_TESTNET_RECV_WINDOW=5000

# Fleet market routing
NEXUS_MARKET_TYPE_BTC=futures
NEXUS_MARKET_TYPE_ETH=futures
NEXUS_MARKET_TYPE_SOL=futures
NEXUS_MARKET_TYPE_PEPE=futures

# Optional symbol overrides
# BINANCE_FUTURES_TESTNET_SYMBOL_PEPE=1000PEPEUSDT

# === Capital / growth mode ===
NEXUS_FUTURES_BASELINE_CAPITAL=11800
NEXUS_CAPITAL_FLOOR=11800
NEXUS_GROWTH_TARGET=17700
NEXUS_BOLD_TESTNET=1
NEXUS_DAILY_PNL_TARGET_PCT=0.003
NEXUS_DAILY_MAX_LOSS_PCT=0.015

# === R-exit (Phase 4A) ===
NEXUS_RISK_PCT=0.10
NEXUS_STOP_R=1.0
NEXUS_BREAK_EVEN_AFTER_TP1=1
NEXUS_SIGNAL_REVERSE_MIN_CONFIDENCE=0.55

# === RADAR dispatch (Phase 4C) ===
NEXUS_RADAR_AUTO_TRADE=1
NEXUS_RADAR_MIN_CANDIDATE_SCORE=55
NEXUS_RADAR_MAX_OPEN_POSITIONS=3
NEXUS_RADAR_MAX_LEVERAGE=15

# === Meetings (wall-clock for 00:00 / 06:00 / 12:00 / 18:00 roundtables) ===
NEXUS_MEETING_TIMEZONE=Asia/Taipei

# === LLM advisory ===
NEXUS_LLM_ENABLE=1
NEXUS_LLM_PROVIDER_CHAT=groq_primary
NEXUS_LLM_MODEL_CHAT=llama-3.3-70b-versatile
GROQ_API_KEY_PRIMARY=
GROQ_API_KEY_SECONDARY=
SAMBANOVA_API_KEY=
NEXUS_LLM_PROVIDER_NEWS=groq_primary
NEXUS_LLM_PROVIDER_RADAR=groq_primary
NEXUS_LLM_PROVIDER_ROUNDTABLE=groq_secondary
NEXUS_LLM_PROVIDER_REFLECTION=groq_secondary
NEXUS_LLM_PROVIDER_AGENT=sambanova
NEXUS_LLM_MODEL_AGENT=Meta-Llama-3.1-405B-Instruct

# === HQ spot treasury display (match Binance App: USDT + USDC only) ===
NEXUS_HQ_SPOT_TRUTH_MODE=stable_only
NEXUS_HQ_SPOT_TRUTH_STABLE_ASSETS=USDT,USDC

# === HQ spot strategy ===
NEXUS_HQ_SPOT_THRESHOLD=0.0035
NEXUS_HQ_SPOT_COOLDOWN_SECONDS=600
NEXUS_NEWS_PAUSE_SECONDS=900

# === Zeabur / cloud (match local .env for seamless handoff) ===
# PORT is injected automatically by Zeabur for the web service.
# Mount a persistent volume at /data on BOTH web and worker services.
NEXUS_DATA_DIR=/data
NEXUS_RUNTIME_DB=trading.db
# NEXUS_EMBEDDED_WORKER=1   # force in-process worker (needed if gunicorn -w>1 or non-Zeabur host)
# NEXUS_WEB_ONLY=1          # web only: disable embedded worker when you run backend.worker.runner separately

# === Phase 8 upgrade track (P0-P3) ===
NEXUS_AUTONOMY_LEVEL=2
NEXUS_LEARNING_AUTO_APPLY=1
NEXUS_LEARNING_AUTO_APPROVE=1
NEXUS_SHADOW_MODE=0
NEXUS_AI_PROPOSAL_MAX_PER_TICK=3
NEXUS_RADAR_UNIVERSE_MAX=50
NEXUS_STRATEGY_VERSION=v1.0.0-core
NEXUS_RADAR_LLM_PROPOSALS=1
NEXUS_RADAR_LLM_MIN_CONFIDENCE=0.55
NEXUS_LLM_PROVIDER_RADAR_PROPOSAL=groq_primary
NEXUS_LLM_MODEL_RADAR_PROPOSAL=llama-3.3-70b-versatile
NEXUS_DAILY_REPORT_ENABLE=1
NEXUS_DAILY_REPORT_SLOTS=00:00,12:00
NEXUS_EMBEDDED_WORKER=1
