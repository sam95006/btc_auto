# =============================================================================
# NEXUS — Zeabur / testnet 完整環境變數（2026-06-01 · Pure AI 大波段 + 獲利加倉）
# 複製為 .env，把「你的_*」換成真實金鑰，勿 commit .env
# 上傳 Zeabur: powershell -ExecutionPolicy Bypass -File tools/deploy/zeabur_pure_ai.ps1
# =============================================================================

# --- Zeabur / 持久化 ---
NEXUS_DATA_DIR=/data
NEXUS_RUNTIME_DB=trading.db
NEXUS_EMBEDDED_WORKER=1
WEB_CONCURRENCY=1
# NEXUS_WEB_ONLY=0

# --- 執行模式 ---
NEXUS_TRADING_MODE=binance_testnet
NEXUS_EXECUTION_MODE=binance_mixed_testnet
NEXUS_RUNTIME_TICK_SECONDS=2
NEXUS_ALWAYS_ON_TRADING=1
NEXUS_BOOTSTRAP_TRADES=1
NEXUS_FUTURES_ONLY_TRADING=1
NEXUS_FUTURES_SCOPE=usdt_m
NEXUS_INCLUDE_COIN_MARGINED=0
NEXUS_PRICE_SOURCE=futures

# --- Binance Testnet API（必填 · 與 App 同一帳戶）---
BINANCE_SPOT_TESTNET_API_KEY=你的_spot_api_key
BINANCE_SPOT_TESTNET_SECRET_KEY=你的_spot_secret_key
BINANCE_FUTURES_TESTNET_API_KEY=你的_futures_api_key
BINANCE_FUTURES_TESTNET_SECRET_KEY=你的_futures_secret_key
BINANCE_FUTURES_BASE_URL=https://demo-fapi.binance.com
BINANCE_TESTNET_VALIDATE_ON_BOOT=0
BINANCE_TESTNET_RECV_WINDOW=5000

# Optional NEXUS_* credential bridge (Phase 0.2)
# NEXUS_READ_BINANCE_API_KEY=
# NEXUS_READ_BINANCE_SECRET_KEY=
# NEXUS_TRADE_BINANCE_API_KEY=
# NEXUS_TRADE_BINANCE_SECRET_KEY=

# --- LLM API（必填至少 Groq primary）---
NEXUS_LLM_ENABLE=1
GROQ_API_KEY_PRIMARY=你的_groq_primary_key
GROQ_API_KEY_SECONDARY=你的_groq_secondary_key
CEREBRAS_API_KEY=你的_cerebras_api_key
SAMBANOVA_API_KEY=你的_sambanova_api_key
NEXUS_LLM_TIMEOUT_SECONDS=12
NEXUS_LLM_MAX_COMPLETION_TOKENS=700

# LLM 供應商 / 模型
NEXUS_LLM_PROVIDER_FLEX_TRADE=groq_primary
NEXUS_LLM_PROVIDER_FLEX_EXIT=groq_primary
NEXUS_LLM_PROVIDER_TRADE_PROPOSER=groq_primary
NEXUS_LLM_PROVIDER_AGENT=cerebras
NEXUS_LLM_PROVIDER_REGIME=groq_secondary
NEXUS_LLM_PROVIDER_POST_MORTEM=cerebras
NEXUS_LLM_PROVIDER_NEWS=groq_primary
NEXUS_LLM_PROVIDER_RADAR=groq_primary
NEXUS_LLM_PROVIDER_ROUNDTABLE=groq_secondary
NEXUS_LLM_PROVIDER_REFLECTION=groq_secondary
NEXUS_LLM_PROVIDER_CHAT=groq_primary
NEXUS_LLM_PROVIDER_RADAR_PROPOSAL=groq_primary
NEXUS_LLM_MODEL_FLEX_TRADE=llama-3.3-70b-versatile
NEXUS_LLM_MODEL_FLEX_EXIT=llama-3.3-70b-versatile
NEXUS_LLM_MODEL_AGENT=llama-3.3-70b
NEXUS_LLM_MODEL_REGIME=mixtral-8x7b-32768
NEXUS_LLM_MODEL_POST_MORTEM=mixtral-8x7b-32768
NEXUS_LLM_MODEL_CHAT=llama-3.3-70b-versatile
NEXUS_LLM_MODEL_RADAR_PROPOSAL=llama-3.3-70b-versatile
NEXUS_LLM_REFRESH_FLEX_TRADE_SECONDS=8
NEXUS_LLM_REFRESH_FLEX_EXIT_SECONDS=15
NEXUS_LLM_REFRESH_TRADE_PROPOSER_SECONDS=20
NEXUS_LLM_REFRESH_AGENT_SECONDS=40
NEXUS_LLM_REFRESH_REGIME_SECONDS=1800
NEXUS_LLM_REFRESH_POST_MORTEM_SECONDS=0

# --- 外部市場 intel API（選填 · 有 key 更準）---
NEXUS_EXTERNAL_MARKET_ENABLED=1
COINGECKO_API_KEY=你的_coingecko_key
COINMARKETCAP_API_KEY=你的_coinmarketcap_key
CRYPTOQUANT_API_KEY=你的_cryptoquant_key
NEXUS_COINGECKO_TOP_N=50
NEXUS_COINGECKO_MIN_VOLUME_USD=5000000
NEXUS_COINGECKO_REFRESH_SECONDS=3600
NEXUS_CMC_REFRESH_SECONDS=900
NEXUS_CRYPTOQUANT_REFRESH_SECONDS=3600

# Fear & Greed（免 key）
NEXUS_FEAR_GREED_ENABLED=1
NEXUS_FEAR_GREED_REFRESH_SECONDS=3600
NEXUS_BINANCE_MACRO_ENABLED=1
NEXUS_BINANCE_MACRO_REFRESH_SECONDS=300

# TradingView webhook（選填）
NEXUS_TRADINGVIEW_WEBHOOK_ENABLED=0
NEXUS_TRADINGVIEW_WEBHOOK_SECRET=你的_tradingview_webhook_secret

# --- Testnet 沙盒 / 資金 ---
NEXUS_TESTNET_SANDBOX=1
NEXUS_BOLD_TESTNET=1
NEXUS_SANDBOX_FORCE_LIVE=1
NEXUS_SANDBOX_AUTO_RESET=1
NEXUS_FUTURES_BASELINE_CAPITAL=5000
NEXUS_SPOT_BASELINE_CAPITAL=5000
NEXUS_USE_LIVE_WALLET_FOR_SIZING=1
NEXUS_CAPITAL_FLOOR=4500
NEXUS_FUTURES_DEPLOY_FRACTION=0.92
NEXUS_TREASURY_ASSETS=USDT
NEXUS_HQ_SPOT_TRUTH_MODE=stable_only
NEXUS_HQ_SPOT_TRUTH_STABLE_ASSETS=USDT,USDC

# --- Pure AI 全自動（主模式 · 規則引擎全部關閉）---
NEXUS_PURE_AI_MODE=1
NEXUS_PURE_AI_LLM_ONLY=1
NEXUS_PURE_AI_BYPASS_VALIDATION=1
NEXUS_PURE_AI_BYPASS_FEE_CHURN=1
NEXUS_PURE_AI_BYPASS_GROWTH_BLOCKS=1
NEXUS_PURE_AI_SKIP_RULE_EXITS=1
NEXUS_PURE_AI_MIN_MARGIN_USD=80
NEXUS_PURE_AI_MAX_MARGIN_USD=120
NEXUS_PURE_AI_TARGET_NOTIONAL_USD=800
NEXUS_PURE_AI_DEFAULT_LEVERAGE=25
NEXUS_PURE_AI_MAX_PROPOSALS=6
NEXUS_PURE_AI_MIN_CONFIDENCE=0.15
NEXUS_PURE_AI_FAST_SCAN=1
NEXUS_PURE_AI_LLM_REFRESH_SECONDS=3
NEXUS_PURE_AI_HEURISTIC_HEARTBEAT=1
NEXUS_PURE_AI_BYPASS_RADAR_COOLDOWN=1
NEXUS_PURE_AI_RADAR_FALLBACK_MAX=4
NEXUS_PURE_AI_HEARTBEAT_MAX=3
NEXUS_PURE_AI_STALE_SAFETY_HOURS=24
NEXUS_PURE_AI_DEBATE_GATE=0
NEXUS_PURE_AI_DEBATE_HARD_VETO=0
NEXUS_PURE_AI_PYRAMID=1
NEXUS_PURE_AI_PYRAMID_MIN_PNL_PCT=12
NEXUS_PURE_AI_PYRAMID_MIN_PNL_USD=25
NEXUS_PURE_AI_PYRAMID_MARGIN_MULT=0.55
NEXUS_PURE_AI_PYRAMID_MAX_ADDS=2
NEXUS_PURE_AI_RADAR_FALLBACK=1
NEXUS_PURE_AI_REQUIRE_MIN_PROPOSALS=1
# Hard exit (mandatory TP/SL — not vetoed by LLM)
NEXUS_PURE_AI_HARD_EXIT=1
NEXUS_PURE_AI_MAX_LEVERAGE=25
NEXUS_PURE_AI_TP_PARTIAL_PCT=12
NEXUS_PURE_AI_TP_FULL_PCT=28
NEXUS_PURE_AI_SL_PCT_ON_MARGIN=16
NEXUS_PURE_AI_TP_ABS_USD=10
NEXUS_PURE_AI_SL_ABS_USD=12
NEXUS_PURE_AI_PARTIAL_FRACTION=0.5
NEXUS_PURE_AI_MAX_ENTRIES_PER_TICK=2
NEXUS_PURE_AI_MAX_PYRAMID_PER_TICK=1
NEXUS_PURE_AI_PYRAMID_COOLDOWN_SECONDS=120
NEXUS_PURE_AI_RESPECT_LEARNING=1
NEXUS_PURE_AI_POST_LOSS_COOLDOWN_MINUTES=45
NEXUS_PURE_AI_UNIVERSE_MAX_SYMBOLS=20
# Optional: confidence-based sizing (testnet only)
# NEXUS_PURE_AI_DYNAMIC_SIZING=1
# NEXUS_PURE_AI_DYNAMIC_LEVERAGE_MIN=20
# NEXUS_PURE_AI_DYNAMIC_LEVERAGE_MAX=100
# NEXUS_PURE_AI_DYNAMIC_MAX_MARGIN_USD=500
# NEXUS_PURE_AI_DYNAMIC_MAX_MARGIN_PCT=0.12
# Sandbox absolute exits (backup layer)
NEXUS_SANDBOX_ABS_EXIT=1
NEXUS_SANDBOX_TP_ABS_USD=15
NEXUS_SANDBOX_SL_ABS_USD=12
NEXUS_SANDBOX_RELAX_EXIT_GUARDS=1
NEXUS_SANDBOX_MIN_HOLD_SECONDS=20

# AI flex 評估（Pure AI 進出場 LLM）
NEXUS_AI_FLEX_EVAL=1
NEXUS_AI_FLEX_EXIT=1
NEXUS_AI_FLEX_PRIMARY=1
NEXUS_AI_FLEX_EXIT_PRIMARY=1
NEXUS_AI_FLEX_SIZING=1
NEXUS_AI_FLEX_AUTO_PROFIT=0
NEXUS_AI_FLEX_HEURISTIC_FALLBACK=0
NEXUS_AI_FLEX_MIN_CONFIDENCE=0.22
NEXUS_AI_FLEX_EXIT_MIN_CONFIDENCE=0.58
NEXUS_AI_FLEX_MAX_PROPOSALS=4
NEXUS_AI_FLEX_MAX_LEVERAGE=100
NEXUS_AI_FLEX_STALE_EXIT_HOURS=24
NEXUS_AI_FLEX_STALE_FLAT_EXIT_HOURS=48

# 關閉規則/艦隊搶決策（Pure AI 必開）
NEXUS_AI_LED_TRADING=1
NEXUS_AI_LED_PRIMARY=0
NEXUS_AI_LED_CORE_FLEETS=0
NEXUS_RULE_SIGNAL_BRIDGE=0
NEXUS_GRID_TRADING=0
NEXUS_FUNDING_ARB=0
NEXUS_DCA_ACCUMULATOR=0
NEXUS_MARKET_NEUTRAL_ENABLED=0
NEXUS_RADAR_AUTO_TRADE=0
NEXUS_RADAR_LLM_PROPOSALS=0

# --- 學習 / 自治 ---
NEXUS_AUTONOMY_LEVEL=2
NEXUS_SHADOW_MODE=0
NEXUS_LEARNING_AUTO_APPLY=1
NEXUS_LEARNING_AUTO_APPROVE=1
NEXUS_LEARNING_HARD_PAUSE=0
NEXUS_RESEARCH_GATE_BLOCK_ENTRIES=0
NEXUS_LEARNING_REQUIRE_RESEARCH_PASS=0

# --- 風控 / 槓桿上限 ---
NEXUS_MAX_SYSTEM_LEVERAGE=100
NEXUS_HARD_MAX_LEVERAGE=100
NEXUS_GROWTH_MAX_LEVERAGE=100
NEXUS_FEE_CHURN_GUARD=1
NEXUS_MIN_MARGIN_USD=45
NEXUS_MIN_NOTIONAL_USD=280
NEXUS_SANDBOX_ABS_EXIT=1
NEXUS_SANDBOX_TP_ABS_USD=80
NEXUS_SANDBOX_SL_ABS_USD=40
NEXUS_SANDBOX_RELAX_EXIT_GUARDS=1

# --- Live sync / UI ---
NEXUS_EXCHANGE_REFRESH_MIN_SECONDS=2
NEXUS_NEWS_REFRESH_SECONDS=60
NEXUS_WS_PUSH_INTERVAL_SECONDS=1
NEXUS_GLOBAL_INDEX_REFRESH_SECONDS=30
NEXUS_LIVE_REFRESH_RADAR=1
NEXUS_MEETING_TIMEZONE=Asia/Taipei
NEXUS_DAILY_REPORT_ENABLE=1
NEXUS_DAILY_REPORT_SLOTS=00:00,12:00

# --- 艦隊路由 ---
NEXUS_MARKET_TYPE_BTC=futures
NEXUS_MARKET_TYPE_ETH=futures
NEXUS_MARKET_TYPE_SOL=futures
NEXUS_MARKET_TYPE_PEPE=futures
NEXUS_RADAR_UNIVERSE_MAX=50

# --- 月營收 KPI（Console 顯示用）---
NEXUS_MONTHLY_REVENUE_TARGET_MODE=third_of_futures_capital
NEXUS_MONTHLY_REVENUE_CAPITAL_FRACTION=0.333333
NEXUS_COMPOUND_REINVEST=1
# Daily target / defense (testnet): tune carefully — higher targets imply higher risk.
NEXUS_DAILY_PNL_TARGET_PCT=0.10
NEXUS_DAILY_MAX_LOSS_PCT=0.05
NEXUS_DAILY_POSITIVE_MODE=1
NEXUS_LOCK_PROFIT_AFTER_DAILY_TARGET=1

# --- Kill-switch（建議保持預設）---
NEXUS_KILL_SWITCH_V2=1
NEXUS_KILL_SWITCH_AUTO_FLATTEN=0
NEXUS_OPS_WEBHOOK_URL=
NEXUS_OPS_WEBHOOK_COOLDOWN_SEC=900
